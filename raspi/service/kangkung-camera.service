[Unit]
Description=Kangkung Live Camera (MJPEG via Tailscale, headless)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/aquaponic/kangkung_pi
ExecStart=/home/aquaponic/kangkung_pi/venv/bin/python camera_live.py --host auto --port 8787 --width 1920 --height 1080 --fps 2
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
