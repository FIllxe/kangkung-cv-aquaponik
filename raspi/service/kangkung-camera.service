[Unit]
Description=Kangkung Live Camera (MJPEG via Tailscale)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/pi/kangkung_pi
ExecStart=/home/pi/kangkung_pi/venv/bin/python camera_live.py --host auto --port 8787 --fps 2
Restart=on-failure
RestartSec=5
User=pi
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
