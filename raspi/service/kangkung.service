[Unit]
Description=Kangkung Aquaponik Live Monitor (Pi -> Firebase)
After=network-online.target
Wants=network-online.target
# Lihat kangkung-camera.service: kamera CSI hanya bisa dipakai satu proses.
Conflicts=kangkung-camera.service

[Service]
Type=simple
WorkingDirectory=/home/pi/kangkung_pi
ExecStart=/home/pi/kangkung_pi/venv/bin/python kangkung_pi.py
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
