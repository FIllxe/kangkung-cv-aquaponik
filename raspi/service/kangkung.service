[Unit]
Description=Kangkung Aquaponik Live Monitor (Pi -> Firebase)
After=network-online.target kangkung-camera.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/aquaponic/kangkung_pi
ExecStart=/home/aquaponic/kangkung_pi/venv/bin/python kangkung_pi.py
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
